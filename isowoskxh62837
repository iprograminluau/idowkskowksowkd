local function buildJobList()
    local jobs, seen = {}, {}
    local function add(j)
        j = tostring(j or "")
        if j ~= "" and not seen[normJob(j)] then
            seen[normJob(j)] = true
            jobs[#jobs + 1] = j
        end
    end

    local finderJobs = {}
    local usePublic = math.random() < (tonumber(st.finderPublicMix) or 0)
    if st.useFinder and not usePublic then
        local want = math.max(0, math.floor(tonumber(st.finderCandidates) or 10))
        if want > 0 then finderJobs = finderPickJobs(want) end
    end

    local publicJobs = {}
    local pubWant = math.max(0, math.floor(tonumber(st.publicCandidates) or 5))
    if pubWant > 0 then
        local servers = fetchHopServers(false)
        if #servers == 0 then servers = fetchHopServers(true) end
        for i = 1, math.min(#servers, pubWant) do
            publicJobs[#publicJobs + 1] = servers[i].id
        end
    end

    local fi, pi = 1, 1
    while fi <= #finderJobs or pi <= #publicJobs do
        for _ = 1, 2 do
            if fi <= #finderJobs then
                add(finderJobs[fi])
                fi = fi + 1
            end
        end
        if pi <= #publicJobs then
            add(publicJobs[pi])
            pi = pi + 1
        end
    end

    return jobs
end

local function hopTo(pid, jobs)
    if #jobs == 0 then return end
    for _, j in ipairs(jobs) do markVisited(j) end

    if not st.kickBeforeHop then
        doTeleport(pid, jobs[1])
        return
    end

    local delaySec = math.max(1, tonumber(st.kickRejoinDelay) or 10)
    notify(("Kicking now, rejoin in %ds (%d candidate servers)"):format(delaySec, #jobs))
    _G.__WISHUB_INTENTIONAL_KICK = true
    task.spawn(function()
        task.wait(delaySec)
        local gap = math.max(0.05, tonumber(st.kickRetryDelay) or 1.2)
        local tries = math.max(1, math.floor(tonumber(st.kickRetryCount) or 20))
        for i = 1, tries do
            local job = jobs[((i - 1) % #jobs) + 1]
            dismissTeleportError()
            doTeleport(pid, job)
            task.wait(gap)
        end
        _G.__WISHUB_INTENTIONAL_KICK = false
    end)
    task.wait(0.2)
    pcall(function() LocalPlayer:Kick("WisHUB server hop") end)
end

local function serverHop()
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if type(q) == "function" then pcall(q, "getgenv().WisHubGaG2TameResume = true") end
    local pid = game.PlaceId
    local attempt = 0
    while st.autoTame and st.autoHop do
        attempt = attempt + 1
        dismissTeleportError()
        teleportFailed = false
        teleportFailResult = nil

        local jobs = buildJobList()
        if #jobs == 0 then
            notify(("No fresh server found, retrying (#%d)"):format(attempt))
            task.wait(2)
            continue
        end
        hopTo(pid, jobs)
        local t0 = os.clock()
        while not teleportFailed and os.clock() - t0 < 25 do
            if not (st.autoTame and st.autoHop) then return false end
            task.wait(0.5)
        end
        if teleportFailed then
            local flooded = teleportFailResult == Enum.TeleportResult.Flooded
            local unauth = teleportFailResult == Enum.TeleportResult.Unauthorized
            for _, j in ipairs(jobs) do
                finderFailedJobs[j] = os.clock() + (unauth and 36000 or 45)
            end
            notify(flooded and ("Rate-limited, waiting (#%d)"):format(attempt)
                or ("Server full/failed, retrying (#%d)"):format(attempt))
            if flooded then task.wait(12) else task.wait() end
        else
            notify(("Teleport stuck, retrying (#%d)"):format(attempt))
            task.wait(1)
        end
    end
    return false
end

local function instantRejoin(reason)
    reportError("Stuck (" .. tostring(reason) .. ") -- instant rejoin")
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if type(q) == "function" then pcall(q, "getgenv().WisHubGaG2TameResume = true") end
    for _ = 1, 6 do
        pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
        task.wait(1.5)
    end
end

