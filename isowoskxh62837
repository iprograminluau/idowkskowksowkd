local function getSellPetVariants(tool, entry)
    local variants = {}
    local candidates = {}
    local function add(v)
        if type(v) == "string" and v ~= "" then candidates[#candidates + 1] = v end
    end
    if tool and typeof(tool) == "Instance" then
        add(tool:GetAttribute("PetSize"))
        add(tool:GetAttribute("PetType"))
    end
    if type(entry) == "table" then
        add(entry.Size)
        add(entry.PetSize)
        add(entry.Type)
        add(entry.PetType)
    end
    for _, v in ipairs(candidates) do
        variants[v] = true
        if PetSizes and type(PetSizes.Normalize) == "function" then
            local okN, norm = pcall(PetSizes.Normalize, v)
            if okN and type(norm) == "string" and norm ~= "" then variants[norm] = true end
        end
    end
    if PetTypes and type(PetTypes.IsRainbow) == "function" then
        local okR, isRb = pcall(PetTypes.IsRainbow, entry or tool)
        if okR and isRb then variants.Rainbow = true end
    end
    return variants
end

local function sellPetBlacklisted(tool, entry)
    local list = st.sellPetBlacklistVariant
    if type(list) ~= "table" then return true end
    if #list == 0 then return false end
    local variants = getSellPetVariants(tool, entry)
    for _, wanted in ipairs(list) do
        wanted = tostring(wanted or "")
        if wanted ~= "" then
            for variant in pairs(variants) do
                if variant == wanted or variant:find(wanted, 1, true) then return true end
            end
        end
    end
    return false
end

local function isSellablePetTool(tool)
    return tool and tool:IsA("Tool")
        and tool:GetAttribute("Pet") ~= nil
        and tool:GetAttribute("PetId") ~= nil
end

local function getSellPetTargets()
    local targets = {}
    local byName = st.selectedSellPetName or {}
    local byRarity = st.selectedSellPetRarity or {}
    if #byName == 0 and #byRarity == 0 then return targets end
    for _, cont in ipairs({ LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character }) do
        if cont then
            for _, tool in ipairs(cont:GetChildren()) do
                if isSellablePetTool(tool) then
                    local petName = tostring(tool:GetAttribute("Pet"))
                    local data = PetData[petName]
                    local rarity = data and data.Rarity
                    local nameMatch = #byName > 0 and table.find(byName, petName)
                    local rarityMatch = #byRarity > 0 and rarity and table.find(byRarity, rarity)
                    if nameMatch or rarityMatch then
                        local entry = getInventoryPetEntry(tool:GetAttribute("PetId"))
                        if entry and not sellPetBlacklisted(tool, entry) then
                            targets[#targets + 1] = tool
                        end
                    end
                end
            end
        end
    end
    return targets
end

local function sellOnePet(tool)
    local hum = getHumanoid()
    if not hum or not tool or not tool.Parent then return false end
    local entry = getInventoryPetEntry(tool:GetAttribute("PetId"))
    if not entry or sellPetBlacklisted(tool, entry) then return false end
    if tool.Parent ~= LocalPlayer.Character then
        hum:EquipTool(tool)
        local t0 = os.clock()
        while tool.Parent ~= LocalPlayer.Character and os.clock() - t0 < 1 do task.wait(0.05) end
    end
    if tool.Parent ~= LocalPlayer.Character then return false end
    local petId = tool:GetAttribute("PetId")
    local npcs = Networking.NPCS
    if not (npcs and npcs.SellPet and petId) then return false end
    local ok, result = pcall(function() return npcs.SellPet:Fire(tostring(petId)) end)
    if not ok then return false end
    if type(result) == "table" and result.Success == false then return false end
    return true
end

