local function tamePet(visual, ref, fromAuto)
    local rp = visual:FindFirstChild("RootPart")
    local prompt = rp and rp:FindFirstChild("BuyPrompt")
    local root = hrp()
    if not (rp and prompt and root) then return false end
    local returnCF = root.CFrame
    if st.protectWildTame then equipShovel() end
    local start = os.clock()
    local lastFire = 0
    local lastT = os.clock()
    local lastAura = 0
    local ok = false
    while os.clock() - start < (st.protectWildTame and 30 or 15) do
        if fromAuto and not st.autoTame then break end
        local petGone = not (visual.Parent and ref.Parent)
        if st.protectWildTame then
            if petGone then
                ok = true
                break
            end
            if os.clock() - lastAura > 0.3 then
                lastAura = os.clock()
                equipShovel()
                protectAura()
            end
        else
            if tamedThis(ref, start) then
                ok = true
                break
            end
            if petGone then
                local g = os.clock()
                while os.clock() - g < 3 do
                    if tamedThis(ref, start) then
                        ok = true
                        break
                    end
                    task.wait(0.1)
                end
                break
            end
            local owner = tonumber(ref:GetAttribute("OwnerUserId")) or 0
            if owner ~= 0 and owner ~= LocalPlayer.UserId then break end
            local cap = tonumber(st.maxPetPrice) or 0
            if cap > 0 and (tonumber(ref:GetAttribute("Price")) or 0) > cap then break end
        end
        local now = os.clock()
        local dt = math.min(now - lastT, 0.1)
        lastT = now
        local goal = (refCFrame(ref) or rp.CFrame).Position
        local cur = root.Position
        local to = goal - cur
        local dist = to.Magnitude
        if st.protectWildTame then
            if dist > 4 then
                local step = math.min(60 * dt, dist - 3)
                local newPos = cur + to.Unit * step
                root.CFrame = CFrame.lookAt(newPos, Vector3.new(goal.X, newPos.Y, goal.Z))
            else
                root.CFrame = CFrame.lookAt(cur, Vector3.new(goal.X, cur.Y, goal.Z))
            end
            pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
        else
            local speed = math.clamp(tonumber(st.tameMoveSpeed) or 16, 4, 50)
            if dist > 5 then
                local step = math.min(speed * dt, dist - 4)
                local nextPos = cur + to.Unit * step
                root.CFrame = CFrame.lookAt(nextPos, Vector3.new(goal.X, nextPos.Y, goal.Z))
                pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
            end
        end
        if dist <= 12 and now - lastFire > 0.4 then
            markTameFired(ref)
            trackFiredPrompt(prompt)
            if type(fireproximityprompt) == "function" then
                pcall(function() fireproximityprompt(prompt) end)
            else
                pcall(function() Networking.Pets.WildPetTame:Fire(ref) end)
            end
            lastFire = now
        end
        RunService.Heartbeat:Wait()
    end
    clearTamePending(ref)
    if not ok then untrackFiredPrompt(prompt) end
    if st.tameReturnAfter then pcall(function() root.CFrame = returnCF end) end
    return ok
end

local function pickTarget()
    local spawns = mapFolder("WildPetSpawns")
    local root = hrp()
    if not (spawns and root) then return nil end
    local best, bestRef, bestDist
    local now = os.clock()
    for _, visual in ipairs(spawns:GetChildren()) do
        local rp = visual:FindFirstChild("RootPart")
        local ref = refFor(visual)
        local cd = cooldown[visual]
        if rp and typeof(ref) == "Instance" and (not cd or cd < now) and tonumber(ref:GetAttribute("OwnerUserId")) == 0 then
            local rarity = tostring(ref:GetAttribute("Rarity"))
            local pname = tostring(ref:GetAttribute("PetName"))
            local price = tonumber(ref:GetAttribute("Price")) or 0
            local cap = tonumber(st.maxPetPrice) or 0
            if matchesWhitelist(rarity, pname) and Sheckles.Value >= price and (cap <= 0 or price <= cap) then
                local d = (rp.Position - root.Position).Magnitude
                if not bestDist or d < bestDist then best, bestRef, bestDist = visual, ref, d end
            end
        end
    end
    return best, bestRef
end

local function prepPrompt(prompt)
    pcall(function()
        prompt.RequiresLineOfSight = false
        prompt.HoldDuration = 0
        if prompt.MaxActivationDistance < 30 then prompt.MaxActivationDistance = 30 end
        prompt.Enabled = true
    end)
end

local TAME_OFFSETS = {
    Vector3.new(0, 0, 0),
    Vector3.new(3, 0, 0),
    Vector3.new(-3, 0, 0),
    Vector3.new(0, 0, 3),
    Vector3.new(0, 0, -3),
    Vector3.new(0, 3, 0),
}

local function fireTame(prompt, ref, attempt)
    local mode = attempt % 3
    if mode == 1 and type(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt) end)
    elseif mode == 2 and type(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt, 1) end)
    else
        pcall(function() Networking.Pets.WildPetTame:Fire(ref) end)
    end
end

local function fastTame(visual, ref)
    local rp = visual:FindFirstChild("RootPart")
    local prompt = rp and rp:FindFirstChild("BuyPrompt")
    local root = hrp()
    if not (rp and prompt and root) then return false end
    prepPrompt(prompt)
    local timeout = math.max(4, tonumber(st.tameTimeout) or 10)
    local start = os.clock()
    local lastT = os.clock()
    local settledAt = nil
    local firedOnce = false
    local firstFireAt = nil
    local attempt = 0
    local lastFire = 0
    local ok = false
    while true do
        if not st.autoTame then break end
        if tamedThis(ref, start) then ok = true break end
        local petGone = not (visual.Parent and ref.Parent)
        if petGone then
            if firedOnce then
                local g = os.clock()
                while os.clock() - g < 1.5 do
                    if tamedThis(ref, start) then break end
                    task.wait(0.1)
                end
                ok = true
            end
            break
        end
        local owner = tonumber(ref:GetAttribute("OwnerUserId")) or 0
        if owner ~= 0 and owner ~= LocalPlayer.UserId then break end
        local cap = tonumber(st.maxPetPrice) or 0
        if cap > 0 and (tonumber(ref:GetAttribute("Price")) or 0) > cap then break end
        if not firedOnce and os.clock() - start > 8 then break end
        if firstFireAt and os.clock() - firstFireAt > timeout then break end
        local now = os.clock()
        local dt = math.min(now - lastT, 0.1)
        lastT = now
        local base = (refCFrame(ref) or rp.CFrame).Position
        local off = TAME_OFFSETS[(math.floor(attempt / 3) % #TAME_OFFSETS) + 1]
        local goal = base + off
        local cur = root.Position
        local to = goal - cur
        local dist = to.Magnitude
        local speed = math.clamp(tonumber(st.tameMoveSpeed) or 16, 4, 50)
        if dist > 6 then
            settledAt = nil
            local step = math.min(speed * dt, dist - 5)
            local nextPos = cur + to.Unit * step
            root.CFrame = CFrame.lookAt(nextPos, Vector3.new(base.X, nextPos.Y, base.Z))
            pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
        else
            root.CFrame = CFrame.lookAt(cur, Vector3.new(base.X, cur.Y, base.Z))
            pcall(function() root.AssemblyLinearVelocity = Vector3.zero end)
            settledAt = settledAt or now
            local settle = math.max(0, tonumber(st.tameSettleTime) or 0.6)
            local gap = firedOnce and 1.2 or 0.4
            if now - settledAt >= settle and now - lastFire > gap then
                lastFire = now
                attempt = attempt + 1
                firedOnce = true
                firstFireAt = firstFireAt or now
                markTameFired(ref)
                trackFiredPrompt(prompt)
                fireTame(prompt, ref, attempt)
            end
        end
        RunService.Heartbeat:Wait()
    end
    clearTamePending(ref)
    if not ok then untrackFiredPrompt(prompt) end
    return ok
end

local function doTameStep(target, ref)
    if st.protectWildTame then
        local name = tostring(ref:GetAttribute("PetName"))
        local price = tonumber(ref:GetAttribute("Price")) or 0
        if tamePet(target, ref, true) then
            notify(("Tamed %s (-%s)"):format(name, tostring(price)))
        else
            cooldown[target] = os.clock() + 12
        end
    else
        if fastTame(target, ref) then
            tameFails[target] = nil
            cooldown[target] = os.clock() + 2
        else
            local n = (tameFails[target] or 0) + 1
            tameFails[target] = n
            local maxFails = math.max(1, tonumber(st.tameMaxFails) or 2)
            if n >= maxFails then
                cooldown[target] = os.clock() + 300
                notify(("Pet stuck x%d, blacklisted for this server"):format(n))
            else
                cooldown[target] = os.clock() + 5
            end
        end
    end
end

