local function finderPetNames()
    local pool = {}
    local want = st.finderRarities
    if type(want) == "table" and #want > 0 then
        for _, r in ipairs(want) do pool[#pool + 1] = r end
    else
        local seen = {}
        for _, rarity in pairs(PetRarityByName) do
            if not seen[rarity] then
                seen[rarity] = true
                pool[#pool + 1] = rarity
            end
        end
    end

    if st.finderRandomRarity and #pool > 0 then
        local pick = pool[math.random(1, #pool)]
        local names = {}
        for name, rarity in pairs(PetRarityByName) do
            if rarity == pick then names[#names + 1] = name end
        end
        if #names > 0 then return names, pick end
    end

    local restrict = #pool > 0 and type(want) == "table" and #want > 0
    local names = {}
    for name, rarity in pairs(PetRarityByName) do
        if not restrict or table.find(want, rarity) then
            names[#names + 1] = name
        end
    end
    return names, nil
end

local function finderFetch()
    if not st.useFinder then return nil end
    local req = finderRequestFn()
    if type(req) ~= "function" then return nil end
    local names, pickedRarity = finderPetNames()
    if #names == 0 then return nil end
    local url = FINDER_BASE .. "?pet_name=" .. table.concat(names, ",")
    local resp
    local ok = pcall(function()
        resp = req({
            Url = url,
            Method = "GET",
            Headers = {
                ["Authorization"] = "Bearer " .. tostring(st.finderToken or ""),
                ["Cache-Control"] = "no-store",
                ["Pragma"] = "no-cache",
            },
        })
    end)
    if not ok or not resp then return nil end
    local body = resp.Body or resp.body
    if type(body) ~= "string" then return nil end
    local decoded
    if not pcall(function() decoded = HttpService:JSONDecode(body) end) then return nil end
    if type(decoded) ~= "table" then return nil end
    return decoded, pickedRarity
end

local function finderPickJobs(count)
    count = math.max(1, math.floor(tonumber(count) or 1))
    local pets, pickedRarity = finderFetch()
    if not pets then return {} end
    local cur = normJob(game.JobId)
    local now = os.time()
    local clock = os.clock()

    local best = {}
    for _, p in ipairs(pets) do
        local job = tostring(p.job_id or "")
        local remain = (tonumber(p.expires_at) and (p.expires_at - now)) or tonumber(p.remaining) or 0
        local players = tonumber(p.players) or 0
        local maxp = tonumber(p.max_players) or 8
        local failed = finderFailedJobs[job]
        if job ~= "" and normJob(job) ~= cur and remain >= FINDER_MIN_REMAINING and players < maxp
            and not (failed and failed > clock) then
            local prev = best[job]
            if not prev or remain > prev.remain then
                best[job] = { players = players, remain = remain }
            end
        end
    end

    local function collect(allowRecent)
        local arr = {}
        for job, info in pairs(best) do
            if allowRecent or not wasRecent(job) then
                arr[#arr + 1] = { job = job, remain = info.remain, players = info.players }
            end
        end
        return arr
    end

    local arr = collect(false)
    if #arr == 0 then arr = collect(true) end
    if #arr == 0 then return {} end

    table.sort(arr, function(a, b) return a.remain > b.remain end)

    local topN = math.max(1, math.floor(tonumber(st.finderFreshTop) or 50))
    if #arr > topN then
        for i = #arr, topN + 1, -1 do arr[i] = nil end
    end

    for i = #arr, 2, -1 do
        local j = math.random(1, i)
        arr[i], arr[j] = arr[j], arr[i]
    end

    local out = {}
    for i = 1, math.min(count, #arr) do out[#out + 1] = arr[i].job end
    if pickedRarity then
        notify(("Finder: %s -> %d fresh servers"):format(pickedRarity, #out))
    end
    return out
end

local function fetchHopServers(allowRecent)
    local pid = game.PlaceId
    local list = {}
    local cursor = ""
    local cur = normJob(game.JobId)
    for _ = 1, 3 do
        local url = "https://games.roblox.com/v1/games/" .. pid .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then url = url .. "&cursor=" .. cursor end
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok then break end
        local ok2, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not (ok2 and type(data) == "table" and type(data.data) == "table") then break end
        for _, s in ipairs(data.data) do
            if normJob(s.id) ~= cur and type(s.playing) == "number" and type(s.maxPlayers) == "number"
                and s.playing < s.maxPlayers
                and (allowRecent or not wasRecent(s.id)) then
                list[#list + 1] = { id = s.id, playing = s.playing }
            end
        end
        cursor = tostring(data.nextPageCursor or "")
        if cursor == "" then break end
    end
    table.sort(list, function(a, b) return a.playing < b.playing end)
    return list
end

local function doTeleport(pid, job)
