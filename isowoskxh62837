    pendingTameAt = os.clock()
    if ref then
        petMeta[petKey(ref.Name)] = {
            name = ref:GetAttribute("PetName"),
            rarity = ref:GetAttribute("Rarity"),
        }
    end
end

local function clearTamePending(ref)
